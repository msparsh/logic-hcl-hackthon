# Team Logic - Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.

APP_ENV=development
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL. Create one without an account: python scripts/create_instant_db.py
# Any postgresql:// or postgres:// URL works; the driver is added automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Separate database for pytest (optional; DB tests are skipped when empty)
TEST_DATABASE_URL=

# LLM providers, tried in this order. A provider with no key is skipped.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Keyless backup provider (no account needed); set to false to disable
POLLINATIONS_ENABLED=true
LLM_TIMEOUT_SECONDS=8

# Agent behaviour (see docs/BUSINESS_RULES.md)
INTENT_CONFIDENCE_THRESHOLD=0.70
PREVIEW_TTL_MINUTES=5
